{
  "name": "@metanull/viewer-i18n",
  "version": "1.4.0",
  "description": "Shared static texts for the MWNF website platform: the core, layout, gallery and exhibition namespaces.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metanull/viewer-i18n.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "namespaces.json",
    "tools/check.mjs"
  ],
  "exports": {
    "./standalone": "./dist/standalone/index.js",
    "./gallery": "./dist/gallery/index.js",
    "./exhibition": "./dist/exhibition/index.js",
    "./namespaces.json": "./namespaces.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "viewer-i18n-check": "tools/check.mjs"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs --dictionary .",
    "test": "node --test \"tools/*.test.mjs\" && npm run check && npm run build"
  }
}
